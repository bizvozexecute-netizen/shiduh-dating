# ---------------------------------------------------------------------------
# Персональные данные и дампы — НИКОГДА не коммитим.
# netcat_files содержит фото анкет, свидетельства о рождении и документы
# о подтверждении еврейства (2,68 ГБ, спецкатегория ПДн).
# ---------------------------------------------------------------------------
shiduh.org/netcat_files/*
# .htaccess этого каталога — наш код (C5: запрет исполнения), он в git
!shiduh.org/netcat_files/.htaccess
*.sql
*.sql.gz
*.tar
*.tar.gz

# ...но скрипты обезличивания — это код, они нужны в репозитории.
# Исключение: выгруженный обезличенный дамп передаётся отдельно.
!tools/*.sql
tools/dump.anonymized.sql

# ---------------------------------------------------------------------------
# Секреты
# vars.inc.php содержит пароль MySQL. В репозитории — только .example.
# ---------------------------------------------------------------------------
.env
shiduh.org/vars.inc.php

# ---------------------------------------------------------------------------
# Генерируемое приложением
# ---------------------------------------------------------------------------
shiduh.org/netcat/tmp/
shiduh.org/netcat_cache/
shiduh.org/netcat_dump/
shiduh.org/netcat_trash/

# ---------------------------------------------------------------------------
# Локальное окружение
# ---------------------------------------------------------------------------
.docker-data/
docker/mysql/dump/
# Сюда 04_export.sh кладёт обезличенный дамп — передаётся отдельно.
dump-out/

# ---------------------------------------------------------------------------
# Книги для RAG и производные от них артефакты — НЕ в репозиторий.
# Книги защищены авторским правом и приходят от заказчика отдельно (как дамп
# и netcat_files). chunks.jsonl содержит их полный текст и воспроизводится
# из books/ скриптом rag/ingest/run_ingest.py — держим локально.
# ---------------------------------------------------------------------------
books/
rag/data/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
.pytest_cache/
.venv/

# ---------------------------------------------------------------------------
# Мусор ОС и редакторов
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
*.swp
.idea/
.vscode/

# служебные логи браузерных проверок
.playwright-mcp/
