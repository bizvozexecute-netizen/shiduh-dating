# Скопируйте этот файл в .env и при необходимости поправьте значения.
# .env в репозиторий не попадает (см. .gitignore).
#
# ВАЖНО: это ЛОКАЛЬНОЕ окружение. Реквизиты продакшена сюда не вписывать —
# п.1 запретов ТЗ: «Никогда не работать с продакшен-базой и продакшен-сервером».

# --- MySQL -----------------------------------------------------------------
NC_MYSQL_HOST=db
NC_MYSQL_PORT=3306
NC_MYSQL_DB_NAME=shiduh_org
NC_MYSQL_USER=shiduh_org
NC_MYSQL_PASSWORD=shiduh_local_dev
MYSQL_ROOT_PASSWORD=root_local_dev

# --- Хост локального сайта -------------------------------------------------
# Используется в netcat/admin/crontab.php вместо захардкоженного прод-домена.
NC_HTTP_HOST=localhost:8080

# --- Проброс портов на хост ------------------------------------------------
HTTP_PORT=8080
MAILPIT_PORT=8025
ADMINER_PORT=8081
DB_PORT=13306
