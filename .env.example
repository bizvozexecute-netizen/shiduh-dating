# Скопируйте этот файл в .env и при необходимости поправьте значения.
# .env в репозиторий не попадает (см. .gitignore).
#
# ВАЖНО: это ЛОКАЛЬНОЕ окружение. Реквизиты продакшена сюда не вписывать —
# п.1 запретов ТЗ: «Никогда не работать с продакшен-базой и продакшен-сервером».

# --- MySQL -----------------------------------------------------------------
NC_MYSQL_HOST=db
NC_MYSQL_PORT=3306
NC_MYSQL_DB_NAME=shiduh_org
NC_MYSQL_USER=shiduh_org
NC_MYSQL_PASSWORD=shiduh_local_dev
MYSQL_ROOT_PASSWORD=root_local_dev

# --- Хост локального сайта -------------------------------------------------
# Используется в netcat/admin/crontab.php вместо захардкоженного прод-домена.
NC_HTTP_HOST=localhost:8080

# --- Проброс портов на хост ------------------------------------------------
HTTP_PORT=8080
MAILPIT_PORT=8025
ADMINER_PORT=8081
DB_PORT=13306

# ===========================================================================
#  Только для тестового стенда (docker-compose.stage.yml).
#  Локально эти переменные не нужны — см. deploy/README.stage.md
# ===========================================================================

# Домен стенда. Обязателен: без TLS проверки доступа в шаблонах редиректят
# на захардкоженный https:// и страница обрывается (находка №16а в AUDIT.md).
STAGE_DOMAIN=stage.shiduh.org

# Базовая авторизация на весь стенд.
# Хеш получить так:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'пароль'
# При вставке в .env экранируйте $ как $$, иначе Compose съест подстановку.
STAGE_USER=team
STAGE_PASS_HASH=
