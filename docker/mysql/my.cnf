[mysqld]

# ---------------------------------------------------------------------------
# Кодировка ровно как на проде: utf8 (= utf8mb3), utf8_general_ci.
# Все 249 таблиц дампа объявлены как DEFAULT CHARSET=utf8, а
# netcat/system/nc_db.class.php:62 делает SET NAMES 'utf8'.
#
# Переход на utf8mb4 сознательно НЕ делается в Фазе A: он сломает
# KEY Keyword(Keyword) и KEY City(City) в Message204 (char(255) x 4 байта
# = 1020 > 1000, лимит ключа MyISAM). Это отдельная задача бэклога.
# ---------------------------------------------------------------------------
character-set-server = utf8
collation-server     = utf8_general_ci

# ---------------------------------------------------------------------------
# sql_mode. Пустой строгий режим обязателен:
#   * ~40 колонок в дампе объявлены как DEFAULT '0000-00-00 00:00:00';
#   * 67 строк данных содержат нулевые даты (Message204.Date_of_birth — 29,
#     User.Date_of_birth — 2, Message6.Created — 36).
# При STRICT_TRANS_TABLES + NO_ZERO_DATE это ERROR 1067 на CREATE TABLE
# и ERROR 1292 на INSERT. Ядро NetCat также рассчитано на нестрогий режим.
# ---------------------------------------------------------------------------
sql_mode = NO_AUTO_VALUE_ON_ZERO

# ---------------------------------------------------------------------------
# Заливка дампа: единый INSERT в Message6 разбит на statements по ~800 КБ,
# в Logging — по ~1 МБ.
# ---------------------------------------------------------------------------
max_allowed_packet = 64M
net_read_timeout   = 600
net_write_timeout  = 600

# ---------------------------------------------------------------------------
# MyISAM — 225 из 249 таблиц, включая Message204 и Message6.
# ---------------------------------------------------------------------------
key_buffer_size          = 128M
myisam_sort_buffer_size  = 64M

innodb_buffer_pool_size  = 256M
innodb_flush_log_at_trx_commit = 2

# Локальная разработка: дать себе видеть медленные запросы легаси-кода
slow_query_log      = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time     = 1

[mysql]
default-character-set = utf8

[client]
default-character-set = utf8
